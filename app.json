{
  "expo": {
    "name": "Pebble",
    "slug": "pebble-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pebbleapp.mobile"
    },
    "android": {
      "package": "com.pebbleapp.mobile",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {},
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Pebble needs access to your location to send you reminders when you're near specific places.",
          "locationAlwaysPermission": "Pebble needs access to your location in the background to send you location-based reminders.",
          "locationWhenInUsePermission": "Pebble needs access to your location to show you nearby reminders.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logo.png"
        }
      ],
      [
        "expo-background-fetch",
        {
          "minimumInterval": 15
        }
      ]
    ]
  }
}