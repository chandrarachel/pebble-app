{
  "expo": {
    "name": "Pebble",
    "slug": "pebble-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pebbleapp.mobile"
    },
    "android": {
      "package": "com.pebbleapp.mobile",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {},
    "plugins": [
      "expo-location",
      [
        "expo-notifications",
        {
          "icon": "./assets/logo.png"
        }
      ]
    ]
  }
}